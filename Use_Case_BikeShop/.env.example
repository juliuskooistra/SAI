# BikeShop settings. Copy to .env, fill in, `chmod 600 .env`. Never commit .env.

# Secret mixed into stored API-key hashes. Long and random:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates every API key (everyone signs in again).
API_KEY_SECRET=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://demo.sai1.airs.iadsf.ch

# BFH inference (MLMP), SPEC §8.1. Key from https://access.mlmp.ti.bfh.ch
# Keys expire after 180 days; then /health shows "inference": "unauthorized".
# Key created on: YYYY-MM-DD
MLMP_API_KEY=
# Defaults, change only if needed:
# MLMP_BASE_URL=https://inference.proxy.ti.bfh.ch/v1
# MLMP_MODEL=gpt-oss:120b

# Demo accounts created by `python -m scripts.seed` (at least 10 characters).
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# Optional: an 'admin' account with the staff role
ADMIN_PASSWORD=

# Email (SPEC §5.9). Mailgun EU; without a key, emails go to the log only.
MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mail.kooistra.ch
# MAIL_FROM=BikeShop <bikeshop@mail.kooistra.ch>
# Public address of the app, for links in emails
PUBLIC_URL=https://demo.sai1.airs.iadsf.ch

# Metrics (SPEC §10.3): /metrics on by default; set 0 where it would be public (Azure)
# METRICS_ENABLED=1

# --- Azure Container Apps only (SPEC §10.2, DEPLOY-azure.md) -----------------
# APP_MODE=all: Litestream restores the database, then runs API + worker.
# APP_MODE=all
# SEED_ON_START=1
# UVICORN_WORKERS=2
# LITESTREAM_AZURE_ACCOUNT_NAME=
# LITESTREAM_AZURE_ACCOUNT_KEY=
# LITESTREAM_AZURE_CONTAINER=litestream
# LITESTREAM_PATH=bikeshop        # bikeshop-staging for the staging copy
