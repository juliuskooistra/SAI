# BikeShop settings. Copy to .env, fill in, `chmod 600 .env`. Never commit .env.

# Secret mixed into stored API-key hashes. Long and random:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates every API key (everyone signs in again).
API_KEY_SECRET=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://demo.sai1.airs.iadsf.ch

# BFH inference (MLMP), SPEC §8.1. Key from https://access.mlmp.ti.bfh.ch
# Keys expire after 180 days; then /health shows "inference": "unauthorized".
# Key created on: YYYY-MM-DD
MLMP_API_KEY=
# Defaults, change only if needed:
# MLMP_BASE_URL=https://inference.proxy.ti.bfh.ch/v1
# MLMP_MODEL=gpt-oss:120b

# Demo accounts created by `python -m scripts.seed` (at least 10 characters).
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=
